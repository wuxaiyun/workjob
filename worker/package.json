{
  "name": "equipment-ledger-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply equipment-ledger-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply equipment-ledger-db --remote",
    "db:seed:local": "wrangler d1 execute equipment-ledger-db --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute equipment-ledger-db --remote --file=./migrations/0002_seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.131.1"
  }
}